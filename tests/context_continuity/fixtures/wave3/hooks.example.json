{
  "description": "Wave 3 non-blocking global context continuity, compact recovery, and subagent lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<REPO_ROOT>/tools/context_continuity/session_start.py\" --quiet-initial",
            "commandWindows": "py -3 \"<REPO_ROOT>\\tools\\context_continuity\\session_start.py\" --quiet-initial",
            "additionalContextLimit": 800,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<REPO_ROOT>/tools/context_continuity/pre_tool_use.py\"",
            "commandWindows": "py -3 \"<REPO_ROOT>\\tools\\context_continuity\\pre_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<REPO_ROOT>/tools/context_continuity/pre_compact.py\" --mutation-only",
            "commandWindows": "py -3 \"<REPO_ROOT>\\tools\\context_continuity\\pre_compact.py\" --mutation-only",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<REPO_ROOT>/tools/context_continuity/post_compact.py\"",
            "commandWindows": "py -3 \"<REPO_ROOT>\\tools\\context_continuity\\post_compact.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<REPO_ROOT>/tools/context_continuity/subagent_start.py\"",
            "commandWindows": "py -3 \"<REPO_ROOT>\\tools\\context_continuity\\subagent_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"<REPO_ROOT>/tools/context_continuity/subagent_stop.py\"",
            "commandWindows": "py -3 \"<REPO_ROOT>\\tools\\context_continuity\\subagent_stop.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
