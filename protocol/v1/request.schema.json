{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow-toolkit/protocol/v1/request.schema.json",
  "title": "TaskGateway protocol v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "operation", "payload"],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "operation": {
      "type": "string",
      "enum": [
        "createTask",
        "proposeNode",
        "runPreflight",
        "prepareAttempt",
        "pollHostActions",
        "submitHostActionResult",
        "bindProviderHandle",
        "appendEvent",
        "requestCompletion",
        "enableGoalMode",
        "revokeGoalMode",
        "recordHumanDecision",
        "requestCancel"
      ]
    },
    "payload": { "type": "object" }
  }
}
