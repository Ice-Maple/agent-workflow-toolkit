{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-workflow-toolkit/protocol/v1/response.schema.json",
  "title": "TaskGateway protocol v1 response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "ok"],
  "properties": {
    "protocol_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "ok": { "type": "boolean" },
    "payload": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      }
    }
  },
  "oneOf": [
    { "required": ["ok", "payload"], "properties": { "ok": { "const": true } } },
    { "required": ["ok", "error"], "properties": { "ok": { "const": false } } }
  ]
}
